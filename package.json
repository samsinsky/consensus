{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "relay": "dist/server/cli.js"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/cli.ts --no-open",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
